# Copy to /home/andan/deploy/quotewisp/.env and fill in the application values.
# Set the deployment directory to 700 and .env to 600. Values have no wrapping quotes.
# Compose reads this as raw env-file content; Compose >= 2.30 is required.
# Keep literal $ characters in passwords; do not escape or quote them.
MYSQL_DSN=sa_test_write:replace-me@tcp(db.example:3306)/sentence_api?tls=true
WEB_SECRET_KEY=replace-with-at-least-32-random-bytes
SITE_CONTACT=ops@example.com
COOKIE_SECURE=true
HTTP_ADDR=:8080

# Optional portable deployment overrides.
QUOTEWISP_IMAGE=sentence-api:1.0.0-rc.2
QUOTEWISP_BIND_IP=172.16.99.100
QUOTEWISP_HOST_PORT=18080
QUOTEWISP_NETWORK=1panel-network
