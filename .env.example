# No database variables: SQLite at DATA_DIR/quotewisp.db.
# Uncomment all four to use an existing MySQL/MariaDB database instead.
# DB_HOST=db.example
# DB_NAME=sentence_api
# DB_USER=sentence_api
# DB_PASSWORD=replace-me
# Local HTTP only; keep true behind production HTTPS.
# COOKIE_SECURE=false

# Optional admin JSON upload limits.
# IMPORT_MAX_UPLOAD_BYTES=33554432
# IMPORT_UPLOAD_TTL=30m
# IMPORT_TIMEOUT=120s

# Compose temporary filesystem capacity for SQLite bulk writes and sorts.
# SQLITE_TMPFS_SIZE=256m
